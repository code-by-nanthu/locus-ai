{
  "name": "locus",
  "version": "1.0.0",
  "description": "Locus — a local AI CLI agent",
  "type": "module",
  "bin": "./dist/index.js",
  "scripts": {
    "build:web": "vite build -c vite.web.config.ts && node scripts/embed-web.js",
    "build": "pnpm build:web && tsc",
    "build:binary": "export PATH=\"$HOME/.bun/bin:$PATH\" && bun build --compile src/index.tsx --outfile bin/locus --external chromium-bidi",
    "lint": "tsc --noEmit",
    "test": "pnpm build && node --test --test-concurrency=1 dist/test/*.test.js",
    "start": "pnpm build && node ./dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "chalk": "^6.0.0",
    "clsx": "^2.1.1",
    "execa": "^10.0.1",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "gradient-string": "^3.0.0",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "lucide-react": "^1.38.0",
    "open": "^11.0.2",
    "openai": "^7.8.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "react-devtools-core": "^7.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
